{
  "outputStyle": "default",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Installing worktree dependencies",
            "timeout": 600,
            "command": "s=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run.sh\"; [ -f \"$s\" ] || exit 0; bash \"$s\" install-worktree-deps || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking comment length",
            "timeout": 20,
            "command": "s=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run.sh\"; [ -f \"$s\" ] || exit 0; bash \"$s\" comment-length"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Removing worktrees whose PR is finished",
            "timeout": 60,
            "command": "s=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run.sh\"; [ -f \"$s\" ] || exit 0; bash \"$s\" cleanup-merged-worktrees || true"
          }
        ]
      }
    ]
  }
}
