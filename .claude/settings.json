{
  "outputStyle": "default",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking comment length",
            "timeout": 20,
            "command": "r=\".claude/hooks/comment-length.sh\"; s=\"${CLAUDE_PROJECT_DIR:-.}/$r\"; [ -f \"$s\" ] || { g=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null </dev/null); s=\"${g%/.git}/$r\"; }; [ -f \"$s\" ] || exit 0; bash \"$s\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/marrow/scripts/guard.sh auto"
          }
        ]
      }
    ]
  }
}
