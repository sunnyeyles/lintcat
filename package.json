{
  "name": "pr-review-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22 <26",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "vitest run",
    "eval": "vitest run --config evals/vitest.eval.config.ts",
    "spinner": "bash scripts/lintcat-spinner.sh",
    "db:generate": "pnpm --filter @pr-review/db db:generate",
    "db:migrate": "pnpm --filter @pr-review/db db:migrate",
    "db:push": "pnpm --filter @pr-review/db db:push",
    "db:studio": "pnpm --filter @pr-review/db db:studio",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dead-code": "knip"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "knip": "^6.37.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
