# Copy the lines you need into .env.local (gitignored) and fill them in.

# Postgres for the dashboard and POST /api/ingest. See packages/db/README.md.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Dashboard sign-in (apps/web) through the GitHub App's user authorization:
# AUTH_GITHUB_ID/SECRET are the App's client id and secret. AUTH_SECRET: `pnpm dlx auth secret`.
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_TRUST_HOST=true

# GitHub App webhook (apps/web). See apps/web/README.md.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_WEBHOOK_SECRET=
# The App's URL slug (github.com/apps/<slug>); shows the dashboard's Install button.
# GITHUB_APP_SLUG=

# Hosted reviews (apps/web and apps/worker must share it). Seals each organization's
# model key at rest; losing it means every owner re-enters their key. `openssl rand -base64 32`
# MODEL_KEY_ENCRYPTION_KEY=
# How often an idle apps/worker polls for jobs, in ms (default 5000).
# WORKER_POLL_MS=

# Organizations are served at <slug>.<APP_DOMAIN>; unset means localhost.
# Production: the apex, e.g. example.com, with *.example.com on Vercel. Unset on
# previews. Locally, lvh.me shares the sign-in across subdomains (see apps/web/README.md).
# APP_DOMAIN=lvh.me
