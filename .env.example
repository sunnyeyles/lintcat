# Copy the lines you need into .env.local (gitignored) and fill them in.

# Postgres for the dashboard and POST /api/ingest. See packages/db/README.md.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Dashboard sign-in (apps/web). AUTH_SECRET: `pnpm dlx auth secret`.
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_TRUST_HOST=true

# Organizations are served at <slug>.<APP_DOMAIN>; unset means localhost.
# Production: the apex, e.g. example.com, with *.example.com on Vercel. Unset on
# previews. Locally, lvh.me shares the sign-in across subdomains (see apps/web/README.md).
# APP_DOMAIN=lvh.me
