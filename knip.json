{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreFiles": [".agents/**", "docs/**"]
    },
    "apps/web": {
      "next": true,
      "entry": ["components/shell/logo-mark.tsx"]
    },
    "apps/mcp": {
      "entry": ["start.mjs"]
    },
    "packages/design": {
      "entry": ["brand/cli/lintcat-spinner.js"]
    },
    "evals": {
      "vitest": {
        "config": ["vitest.config.ts", "vitest.eval.config.ts"]
      },
      "project": ["**/*.ts", "!fixtures/**"]
    }
  }
}
