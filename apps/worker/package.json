{
  "name": "@pr-review/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "node ../../scripts/build-bundle.mjs",
    "start": "node start.mjs"
  },
  "dependencies": {
    "@pr-review/ai": "workspace:*",
    "@pr-review/db": "workspace:*",
    "@pr-review/github": "workspace:*",
    "@pr-review/logging": "workspace:*",
    "@pr-review/reviewer": "workspace:*",
    "@pr-review/schemas": "workspace:*"
  },
  "devDependencies": {
    "@pr-review/eslint-config": "workspace:*"
  }
}
